import tomli_w
import lark

grammar = r"""
start: value+

NUM: /0[oO][0-9]+/
NAME: /[a-z][a-z0-9_]*/

assigh: NAME "=" value
dictionary: "{" assigh+ "}"
array: "array(" value (", "value)* ")"
value: dictionary | NUM | array

%ignore /\s/          
"""

class T(lark.Transformer):
    NAME = str
    def NUM(self, value):
        return int(value, 8)
    def assigh(self, name):
        return name
    def dictionary(self, assigh):
        return dict(assigh)
    def array(self, value):
        return value
    def value(self, value):
        return value[0]
    def start(self, value):
        return value[0]

INPUT = '''
{ abc = 0o42
  def = array(0o42, 0o1)
  xyz = { key = 0o123 } }
'''

EXPECTED_OUTPUT = '''
abc = 34
def = [34, 1]

[xyz]
key = 83
'''

def transform(input: str) -> str:
    parser = lark.Lark(grammar)
    tree = parser.parse(input)
    tree = T(visit_tokens=True).transform(tree)
    output = tomli_w.dumps(tree)
    return output

print(transform(INPUT))
